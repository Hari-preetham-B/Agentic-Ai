# CareerTwin Environment Variables
# Copy this file to .env and fill in the values.

# ============================================================================
# Frontend (Next.js) — Browser-safe public variables
# ============================================================================

# Supabase project URL (public, safe for browser)
# Obtain from: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key (public, safe for browser)
# Obtain from: Supabase Dashboard → Settings → API → anon/public key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================================
# Backend (FastAPI) — Server-side only, NEVER expose to browser
# ============================================================================

# Environment
ENVIRONMENT=development

# Supabase (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Database (PostgreSQL via SQLAlchemy async + asyncpg)
# Example: postgresql+asyncpg://postgres:password@localhost:5432/careertwin
DATABASE_URL=

# LLM provider (server-side only)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Embedding provider (server-side only)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=384
