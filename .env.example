# CareerTwin — Root environment variables
# Copy this file to .env and fill in values as needed. Never commit real secrets.

# Application
ENVIRONMENT=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Supabase (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider (server-side only — provider choice intentionally not locked)
LLM_PROVIDER=
LLM_API_KEY=
