# CareerTwin — environment variables
#
# ONE FILE FOR EVERYTHING: copy this to ".env" in the repository root.
# Both the API (apps/api) and the web app (apps/web) read it.
# (apps/api/.env and apps/web/.env.local also work and take priority.)
#
# Never commit the real file. Only NEXT_PUBLIC_* values reach the browser.

# ---------------------------------------------------------------- Web (browser-safe)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------- API (server-side only)
ENVIRONMENT=development
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Auth. SUPABASE_URL must be the same project as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
# Secret / service-role key. Used only to auto-confirm sign-ups in development.
SUPABASE_SECRET_KEY=
# Only needed if your project still signs tokens with the legacy "JWT secret"
# (Project Settings -> API -> JWT Settings). Projects using the new asymmetric
# signing keys do not need it.
SUPABASE_JWT_SECRET=
# true = new accounts can sign in immediately. Set false in production.
AUTO_CONFIRM_SIGNUPS=true

# Supabase -> Connect -> ORM/Postgres. Use the "Session pooler" string (port 5432)
# if your network has no IPv6. Change the scheme to postgresql+asyncpg:// and
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
#   postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# LLM (leave LLM_PROVIDER empty to use the deterministic fallback provider)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
# Tried in order if the primary model is unavailable, e.g. gemini-2.5-flash
LLM_FALLBACK_MODELS=

# Embeddings. Evidence retrieval currently runs on the deterministic fallback
# embedder end to end (see README "Known limitations").
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=384
