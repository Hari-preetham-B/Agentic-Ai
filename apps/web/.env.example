# CareerTwin — Frontend environment variables (browser-safe only)
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# Copy this file to .env.local and fill in your values.

# Backend API URL (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (public, client-side only)
# Obtain from: Supabase Dashboard → Settings → API

# NEXT_PUBLIC_SUPABASE_URL: Your Supabase project URL
# Safe for browser — this is the public project endpoint
NEXT_PUBLIC_SUPABASE_URL=

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: Public anon/publishable key
# Safe for browser — this key has limited permissions via RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
