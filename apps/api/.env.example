# CareerTwin — Backend environment variables (server-side only)
# These variables are NEVER exposed to the browser.
# Copy this file to .env and fill in your values.

# Environment
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Supabase (server-side only)
# SUPABASE_URL: Your Supabase project URL (e.g., https://xxx.supabase.co)
# Obtain from: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=

# SUPABASE_PUBLISHABLE_KEY: Public anon key (safe for browser, but also used server-side)
# Obtain from: Supabase Dashboard → Settings → API → anon/public key
SUPABASE_PUBLISHABLE_KEY=

# SUPABASE_SECRET_KEY: Server-only secret key (NEVER expose to browser)
# Obtain from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SECRET_KEY=

# SUPABASE_JWT_SECRET: JWT signing secret for token validation
# Obtain from: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# Database (PostgreSQL via SQLAlchemy async + asyncpg / Supabase)
# Example: postgresql+asyncpg://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# LLM provider (server-side only)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Embedding provider (server-side only)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=384
