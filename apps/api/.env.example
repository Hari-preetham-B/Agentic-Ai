# CareerTwin — Backend environment variables
# These variables are server-side only. Never commit real secrets.

ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Database (PostgreSQL via SQLAlchemy async + asyncpg / Supabase)
# Example: postgresql+asyncpg://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL=

# Supabase (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider — server-side only. The provider choice is intentionally not locked yet.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
