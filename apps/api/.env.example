# CareerTwin — Backend environment variables (server-side only)
# These variables are NEVER exposed to the browser.
# Copy this file to .env and fill in your values.

# Environment
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Supabase (server-side only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# Database (PostgreSQL via SQLAlchemy async + asyncpg / Supabase)
# Format: postgresql+asyncpg://postgres:password@db..supabase.co:5432/postgres
DATABASE_URL=

# LLM provider (server-side only)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=

# Embedding provider (server-side only)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=384
