# CareerTwin API — optional overrides. Prefer the single root ".env"
# (see ../../.env.example). Values here override the root file.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
LLM_FALLBACK_MODELS=
EMBEDDING_DIMENSION=384
